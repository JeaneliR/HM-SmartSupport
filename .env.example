# Copia este archivo como .env y coloca tu clave real.
# Nunca publiques el archivo .env.
OPENAI_API_KEY=sk-reemplaza_con_tu_clave

# Puedes cambiar los modelos sin modificar el codigo.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Limites y comportamiento
MAX_HISTORY_MESSAGES=12
MAX_AUDIO_MB=25

